# Backend Environment Variables

# Server
PORT=3000
NODE_ENV=development
ENABLE_TEST_ENDPOINTS=false
LOG_LEVEL=info
# Optional: protect /metrics endpoint with this header key (x-metrics-key)
METRICS_API_KEY=
# Optional: durable growth rollups (paywall/translation) stored in DB
# Defaults: enabled outside tests, disabled in tests.
ENABLE_GROWTH_ROLLUP_PERSISTENCE=true
# Optional: critical error alerts webhook (Slack/Discord/custom)
ALERT_WEBHOOK_URL=
ALERT_MIN_LEVEL=error
ALERT_COOLDOWN_MS=60000

# Supabase (Much easier than raw PostgreSQL!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_RECORDINGS_BUCKET=recordings

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API (YOU pay for this)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID=903412447976-ck8a4q8ke67ilsaue2qfn50u8p78fpsh.apps.googleusercontent.com

# Google Play Console (for in-app purchases)
# Download service account JSON from Google Play Console > API access
GOOGLE_SERVICE_ACCOUNT_PATH=./google-play-service-account.json
GOOGLE_PACKAGE_NAME=com.recaply.app
LITE_SUBSCRIPTION_PRODUCT_ID=recaply_lite_monthly
PRO_SUBSCRIPTION_PRODUCT_ID=recaply_pro_monthly

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# Subscription Plans (in cents)
FREE_TIER_MINUTES=30
LITE_PLAN_PRICE=900
LITE_PLAN_MINUTES=300
PRO_PLAN_PRICE=1900
PRO_PLAN_MINUTES=999999

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
